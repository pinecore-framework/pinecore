# Normalize line endings: LF in the repository and in the working tree on every
# platform. Overrides a contributor's core.autocrlf so checkouts stay LF, which
# matches the LF rule enforced by .editorconfig.
* text=auto eol=lf

# Known binary types: never apply EOL conversion or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.phar  binary

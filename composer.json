{
    "name": "pinecore/pinecore",
    "description": "Minimal PHP framework for long-running workers",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.0",
        "lcobucci/jwt": "^5.0",
        "psr/log": "^3.0",
        "psr/clock": "^1.0",
        "league/climate": "^3.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mongodb/mongodb": "^1.21",
        "ext-pdo_sqlite": "*"
    },
    "suggest": {
        "mongodb/mongodb": "MongoDB ORM (AbstractMongoRepository, MongoHydrator); requires ext-mongodb",
        "ext-pdo": "SQL ORM (AbstractSqlRepository)",
        "ext-pdo_pgsql": "PostgreSQL driver for the SQL ORM and pgvector vector search"
    },
    "autoload": {
        "psr-4": {"Pinecore\\Pinecore\\": "src/"},
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {"Tests\\Pinecore\\Pinecore\\": "tests/"}
    }
}

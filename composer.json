{
    "name": "pronchev/pinecore",
    "description": "Minimal PHP framework for long-running workers",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.0",
        "mongodb/mongodb": "^2.2.0",
        "lcobucci/jwt": "^5.0",
        "psr/log": "^3.0",
        "psr/clock": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Pronchev\\Pinecore\\": "src/"},
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {"Tests\\Pronchev\\Pinecore\\": "tests/"}
    }
}
